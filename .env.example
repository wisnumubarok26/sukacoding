# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Keamanan - GANTI dengan string acak yang panjang & rahasia saat production
JWT_SECRET=
COOKIE_SECRET=

# Database PostgreSQL
# Format: postgres://user:password@host:port/nama_database
# Untuk development lokal (setelah install PostgreSQL di komputer Anda):
DATABASE_URL=
# Set DB_SSL=true kalau memakai layanan Postgres cloud yang mewajibkan SSL
# (Neon, Render, Railway biasanya otomatis menambahkan ?sslmode=require di URL-nya)
DB_SSL=false

# Email (SMTP) - untuk verifikasi akun & struk pembayaran
# Kosongkan semua kalau belum siap; sistem akan otomatis pakai "mode simulasi"
# (email tidak benar-benar terkirim, hanya dicatat di log server) supaya alur tetap bisa dites.
# Contoh dengan Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, gunakan App Password (bukan password akun biasa)
# Contoh dengan layanan lain: Mailgun, Zoho Mail, Resend (SMTP mode), SendGrid, dll.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SukaCoding" <no-reply@sukacoding.com>

# Midtrans Payment Gateway (daftar gratis di https://dashboard.midtrans.com untuk sandbox)
# Jika kosong, sistem otomatis pakai MODE SIMULASI pembayaran (untuk development/testing)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Akun admin pertama yang dibuat otomatis saat `npm run seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
