<%- include('../partials/head') %>
<%- include('_layout_start') %>

<div class="p-6 lg:p-8">
  <h1 class="font-display text-2xl font-bold text-slate-900 mb-6">Kelola Pengguna</h1>

  <div class="bg-white border border-slate-100 rounded-2xl overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-slate-500 text-left">
        <tr>
          <th class="px-5 py-3">Nama</th>
          <th class="px-5 py-3">Email</th>
          <th class="px-5 py-3">Role</th>
          <th class="px-5 py-3">Status</th>
          <th class="px-5 py-3">Bergabung</th>
          <th class="px-5 py-3 text-right">Aksi</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% users.forEach(u => { %>
          <tr>
            <td class="px-5 py-3 font-medium text-slate-700"><%= u.name %></td>
            <td class="px-5 py-3 text-slate-500"><%= u.email %></td>
            <td class="px-5 py-3">
              <span class="text-xs font-semibold px-2.5 py-1 rounded-full <%= u.role === 'admin' ? 'bg-brand-50 text-brand-600' : 'bg-slate-100 text-slate-500' %>"><%= u.role %></span>
            </td>
            <td class="px-5 py-3">
              <span class="text-xs font-semibold px-2.5 py-1 rounded-full <%= u.is_active ? 'bg-mint-400/10 text-mint-600' : 'bg-red-50 text-red-500' %>"><%= u.is_active ? 'Aktif' : 'Nonaktif' %></span>
            </td>
            <td class="px-5 py-3 text-slate-400"><%= new Date(u.created_at).toLocaleDateString('id-ID') %></td>
            <td class="px-5 py-3 text-right">
              <% if (u.role !== 'admin') { %>
                <form action="/admin/users/<%= u.id %>/toggle" method="POST" class="inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="text-brand-600 hover:underline font-medium"><%= u.is_active ? 'Nonaktifkan' : 'Aktifkan' %></button>
                </form>
              <% } else { %>
                <span class="text-slate-300">—</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('_layout_end') %>
<%- include('../partials/footer') %>
