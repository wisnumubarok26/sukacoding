<%- include('../partials/head') %>
<%- include('_layout_start') %>

<div class="p-6 lg:p-8 max-w-3xl">
  <h1 class="font-display text-2xl font-bold text-slate-900 mb-6"><%= event ? 'Edit Event' : 'Tambah Event' %></h1>

  <% if (errors && errors.length) { %>
    <div class="bg-red-50 text-red-600 text-sm rounded-lg p-3 mb-5">
      <% errors.forEach(e => { %><p><%= e.msg %></p><% }) %>
    </div>
  <% } %>

  <div class="bg-white border border-slate-100 rounded-2xl p-6">
    <form action="<%= event ? '/admin/events/' + event.id : '/admin/events' %>" method="POST" class="space-y-5">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Judul Event</label>
        <input type="text" name="title" required value="<%= event ? event.title : '' %>" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-brand-500 outline-none" />
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Deskripsi</label>
        <textarea name="description" rows="5" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-brand-500 outline-none"><%= event ? event.description : '' %></textarea>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">URL Banner (opsional)</label>
        <input type="url" name="banner_image" value="<%= event ? event.banner_image : '' %>" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-brand-500 outline-none" placeholder="https://..." />
      </div>

      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Tanggal & Waktu</label>
          <input type="datetime-local" name="event_date" required value="<%= event ? new Date(event.event_date).toISOString().slice(0,16) : '' %>" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-brand-500 outline-none" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Lokasi (jika offline)</label>
          <input type="text" name="location" value="<%= event ? event.location : '' %>" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-brand-500 outline-none" placeholder="Contoh: Aula SukaCoding" />
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Link Pendaftaran (opsional)</label>
        <input type="url" name="registration_link" value="<%= event ? event.registration_link : '' %>" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-brand-500 outline-none" placeholder="https://forms.gle/..." />
      </div>

      <div class="flex gap-6">
        <label class="flex items-center gap-2.5">
          <input type="checkbox" name="is_online" value="1" <%= !event || event.is_online ? 'checked' : '' %> class="w-4 h-4 rounded text-brand-600" />
          <span class="text-sm text-slate-700">Event Online</span>
        </label>
        <label class="flex items-center gap-2.5">
          <input type="checkbox" name="is_published" value="1" <%= !event || event.is_published ? 'checked' : '' %> class="w-4 h-4 rounded text-brand-600" />
          <span class="text-sm text-slate-700">Publikasikan</span>
        </label>
      </div>

      <button type="submit" class="bg-brand-600 hover:bg-brand-700 text-white font-semibold px-6 py-3 rounded-xl transition"><%= event ? 'Simpan Perubahan' : 'Buat Event' %></button>
    </form>
  </div>
</div>

<%- include('_layout_end') %>
<%- include('../partials/footer') %>
