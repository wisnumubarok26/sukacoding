<%- include('../partials/head') %>
<%- include('_layout_start') %>

<div class="p-6 lg:p-8">
  <h1 class="font-display text-2xl font-bold text-slate-900 mb-6">Riwayat Transaksi</h1>

  <div class="bg-white border border-slate-100 rounded-2xl overflow-hidden overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-slate-500 text-left">
        <tr>
          <th class="px-5 py-3">Kode Order</th>
          <th class="px-5 py-3">Pelanggan</th>
          <th class="px-5 py-3">Course</th>
          <th class="px-5 py-3">Jumlah</th>
          <th class="px-5 py-3">Metode</th>
          <th class="px-5 py-3">Status</th>
          <th class="px-5 py-3">Tanggal</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if (orders.length === 0) { %>
          <tr><td colspan="7" class="px-5 py-6 text-center text-slate-400">Belum ada transaksi.</td></tr>
        <% } %>
        <% orders.forEach(o => { %>
          <tr>
            <td class="px-5 py-3 font-mono text-xs text-slate-500"><%= o.order_code %></td>
            <td class="px-5 py-3 font-medium text-slate-700"><%= o.user_name %><br/><span class="text-xs text-slate-400"><%= o.user_email %></span></td>
            <td class="px-5 py-3 text-slate-500 line-clamp-1"><%= o.course_title %></td>
            <td class="px-5 py-3"><%= formatRupiah(o.amount) %></td>
            <td class="px-5 py-3 text-slate-500"><%= o.payment_method || '-' %></td>
            <td class="px-5 py-3">
              <span class="text-xs font-semibold px-2.5 py-1 rounded-full <%= o.status === 'paid' ? 'bg-mint-400/10 text-mint-600' : o.status === 'pending' ? 'bg-amber-50 text-amber-600' : 'bg-red-50 text-red-500' %>">
                <%= o.status === 'paid' ? 'Lunas' : o.status === 'pending' ? 'Menunggu' : 'Gagal' %>
              </span>
            </td>
            <td class="px-5 py-3 text-slate-400"><%= new Date(o.created_at).toLocaleDateString('id-ID') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('_layout_end') %>
<%- include('../partials/footer') %>
