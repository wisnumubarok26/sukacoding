<div class="flex min-h-screen bg-slate-50">
  <aside class="w-64 bg-slate-900 text-slate-300 shrink-0 hidden lg:block">
    <div class="p-6 border-b border-slate-800">
      <a href="/" class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-500 to-mint-400 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L4.5 12l5.25-5M14.25 7L19.5 12l-5.25 5" /></svg>
        </div>
        <span class="font-display font-extrabold text-white">SukaCoding</span>
      </a>
      <p class="text-xs text-slate-500 mt-1">Panel Admin</p>
    </div>
    <nav class="p-4 space-y-1">
      <a href="/admin" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium <%= currentPath === '/admin' ? 'bg-brand-600 text-white' : 'hover:bg-slate-800' %>">Dashboard</a>
      <a href="/admin/courses" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium <%= currentPath.startsWith('/admin/courses') ? 'bg-brand-600 text-white' : 'hover:bg-slate-800' %>">Kelola Course</a>
      <a href="/admin/events" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium <%= currentPath.startsWith('/admin/events') ? 'bg-brand-600 text-white' : 'hover:bg-slate-800' %>">Kelola Event</a>
      <a href="/admin/orders" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium <%= currentPath.startsWith('/admin/orders') ? 'bg-brand-600 text-white' : 'hover:bg-slate-800' %>">Transaksi</a>
      <a href="/admin/users" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium <%= currentPath.startsWith('/admin/users') ? 'bg-brand-600 text-white' : 'hover:bg-slate-800' %>">Pengguna</a>
      <div class="border-t border-slate-800 my-3"></div>
      <a href="/" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium hover:bg-slate-800">Lihat Website</a>
      <form action="/logout" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button class="w-full text-left flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium hover:bg-slate-800 text-red-400">Keluar</button>
      </form>
    </nav>
  </aside>

  <main class="flex-1 min-w-0">
    <div class="bg-white border-b border-slate-200 px-6 py-4 flex items-center justify-between lg:hidden">
      <span class="font-display font-bold">SukaCoding Admin</span>
      <a href="/" class="text-xs text-brand-600 font-semibold">Lihat Website</a>
    </div>
