<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="max-w-lg mx-auto px-4 py-16">
  <h1 class="font-display text-2xl font-bold text-slate-900 mb-6 text-center">Checkout</h1>

  <div class="bg-white border border-slate-100 rounded-2xl shadow-soft p-6">
    <div class="flex items-center gap-4 pb-5 border-b border-slate-100">
      <div class="w-16 h-16 rounded-xl bg-gradient-to-br from-brand-100 to-mint-100 flex items-center justify-center text-2xl shrink-0">
        <% if (course.thumbnail) { %><img src="<%= course.thumbnail %>" class="w-full h-full object-cover rounded-xl" alt="" /><% } else { %><span class="text-lg font-semibold text-slate-500">Course</span><% } %>
      </div>
      <div>
        <p class="font-display font-bold text-slate-900"><%= course.title %></p>
        <p class="text-xs text-slate-400 mt-1">Akses selama <%= course.access_duration_days %> hari</p>
      </div>
    </div>

    <form action="/checkout/<%= course.slug %>" method="GET" class="py-5 border-b border-slate-100">
      <label class="block text-sm font-medium text-slate-700 mb-1.5">Kode promo atau referral</label>
      <div class="flex gap-2">
        <input type="text" name="promo" value="<%= promo ? promo.code : '' %>" placeholder="Contoh: BELAJAR10" class="min-w-0 flex-1 px-3 py-2.5 rounded-lg border border-slate-200 text-sm uppercase" />
        <button class="bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold px-4 rounded-lg">Pakai</button>
      </div>
      <% if (promoError) { %><p class="text-xs text-red-500 mt-2"><%= promoError %></p><% } %>
      <% if (promo) { %><p class="text-xs text-mint-600 mt-2">Promo diterapkan: diskon <%= promo.discount_type === 'percent' ? promo.discount_value + '%' : formatRupiah(promo.discount_value) %></p><% } %>
    </form>

    <div class="py-5 space-y-2">
      <div class="flex items-center justify-between text-sm text-slate-500"><span>Harga course</span><span><%= formatRupiah(course.price) %></span></div>
      <% if (discountAmount > 0) { %><div class="flex items-center justify-between text-sm text-mint-600"><span>Diskon</span><span>-<%= formatRupiah(discountAmount) %></span></div><% } %>
      <div class="flex items-center justify-between"><span class="font-semibold text-slate-700">Total Pembayaran</span><span class="font-display text-2xl font-extrabold text-slate-900"><%= formatRupiah(finalAmount) %></span></div>
    </div>

    <% if (snapError) { %>
      <div class="bg-red-50 text-red-600 text-sm rounded-lg p-3 mb-4"><%= snapError %></div>
    <% } %>

    <% if (midtransEnabled && snapToken) { %>
      <button id="pay-button" class="w-full bg-brand-600 hover:bg-brand-700 text-white font-semibold py-3.5 rounded-xl shadow-soft transition">Bayar Sekarang</button>
      <script src="https://app.<%= isProduction ? '' : 'sandbox.' %>midtrans.com/snap/snap.js" data-client-key="<%= clientKey %>"></script>
      <script>
        document.getElementById('pay-button').addEventListener('click', function () {
          window.snap.pay('<%= snapToken %>', {
            onSuccess: function () { window.location.href = '/payment/status/<%= orderCode %>'; },
            onPending: function () { window.location.href = '/payment/status/<%= orderCode %>'; },
            onError: function () { alert('Pembayaran gagal, silakan coba lagi.'); },
            onClose: function () { /* user menutup popup pembayaran */ },
          });
        });
      </script>
    <% } else { %>
      <!-- MODE SIMULASI: Midtrans belum dikonfigurasi. Gunakan tombol ini untuk demo/testing alur pembayaran. -->
      <div class="bg-amber-50 text-amber-700 text-xs rounded-lg p-3 mb-4">
        Mode simulasi aktif (payment gateway belum dikonfigurasi). Klik tombol di bawah untuk mensimulasikan pembayaran berhasil.
      </div>
      <form action="/payment/simulate/<%= orderCode %>" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="w-full bg-brand-600 hover:bg-brand-700 text-white font-semibold py-3.5 rounded-xl shadow-soft transition">Simulasikan Pembayaran Berhasil</button>
      </form>
    <% } %>

    <p class="text-xs text-slate-400 text-center mt-4">Kode Order: <%= orderCode %></p>
  </div>
</div>

<%- include('partials/footer') %>
