<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="bg-gradient-to-br from-brand-700 to-mint-500 py-14">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="font-display text-3xl font-extrabold text-white mb-2">Semua Course</h1>
    <p class="text-brand-100">Pilih course sesuai minatmu, coba video gratis dulu sebelum berlangganan</p>
  </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <form method="GET" class="flex flex-col sm:flex-row gap-3 mb-8">
    <input type="text" name="q" value="<%= q %>" placeholder="Cari course..." class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-brand-500 outline-none text-sm" />
    <select name="category" class="px-4 py-2.5 rounded-xl border border-slate-200 text-sm">
      <option value="">Semua Kategori</option>
      <% categories.forEach(c => { %>
        <option value="<%= c %>" <%= activeCategory === c ? 'selected' : '' %>><%= c %></option>
      <% }) %>
    </select>
    <button class="bg-brand-600 hover:bg-brand-700 text-white font-semibold px-6 py-2.5 rounded-xl transition">Cari</button>
  </form>

  <% if (courses.length === 0) { %>
    <div class="text-center py-20 text-slate-400">
      <p class="text-lg">Tidak ada course yang cocok dengan pencarianmu.</p>
    </div>
  <% } else { %>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% courses.forEach(course => { %>
        <a href="/courses/<%= course.slug %>" class="group bg-white border border-slate-100 rounded-2xl overflow-hidden hover:shadow-soft transition">
          <div class="h-40 bg-gradient-to-br from-brand-100 to-mint-100 flex items-center justify-center overflow-hidden">
            <% if (course.thumbnail) { %>
              <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover" />
            <% } else { %><span class="text-lg font-semibold text-slate-500">Course</span><% } %>
          </div>
          <div class="p-5">
            <span class="text-xs font-semibold text-brand-600 bg-brand-50 px-2.5 py-1 rounded-full"><%= course.category %></span>
            <h3 class="font-display font-bold text-slate-900 mt-3 group-hover:text-brand-600 transition line-clamp-2"><%= course.title %></h3>
            <p class="text-sm text-slate-500 mt-2 line-clamp-2"><%= course.short_description %></p>
            <div class="flex items-center justify-between mt-4 pt-4 border-t border-slate-100">
              <span class="font-bold text-slate-900"><%= course.price > 0 ? formatRupiah(course.price) : 'Gratis' %></span>
              <span class="text-xs text-slate-400"><%= course.level %></span>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
