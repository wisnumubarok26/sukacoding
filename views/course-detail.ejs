<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="bg-slate-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 grid lg:grid-cols-3 gap-10">
    <div class="lg:col-span-2">
      <span class="inline-block text-xs font-semibold text-mint-400 bg-white/10 px-3 py-1 rounded-full mb-4"><%= course.category %> · <%= course.level %></span>
      <h1 class="font-display text-3xl font-extrabold text-white mb-4"><%= course.title %></h1>
      <p class="text-slate-300 leading-relaxed"><%= course.short_description %></p>
      <div class="flex items-center gap-5 mt-6 text-sm text-slate-300">
        <span>📚 <%= totalLessons %> video pelajaran</span>
        <span>🎁 <%= freeLessons %> video gratis</span>
        <span>⏳ Akses <%= course.access_duration_days %> hari</span>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-soft p-6 h-fit">
      <div class="h-36 rounded-xl bg-gradient-to-br from-brand-100 to-mint-100 flex items-center justify-center mb-5 overflow-hidden">
        <% if (course.thumbnail) { %><img src="<%= course.thumbnail %>" class="w-full h-full object-cover" alt="" /><% } else { %><span class="text-4xl">💻</span><% } %>
      </div>
      <p class="font-display text-2xl font-extrabold text-slate-900 mb-4">
        <%= course.price > 0 ? formatRupiah(course.price) : 'Gratis' %>
      </p>

      <% if (hasAccess) { %>
        <div class="bg-mint-400/10 text-mint-600 text-sm font-semibold rounded-lg p-3 mb-4 text-center">
          ✅ Kamu punya akses penuh sampai <%= new Date(enrollment.expires_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
        </div>
        <% if (sections[0] && sections[0].lessons[0]) { %>
          <a href="/courses/<%= course.slug %>/watch/<%= sections[0].lessons[0].id %>" class="block text-center w-full bg-brand-600 hover:bg-brand-700 text-white font-semibold py-3 rounded-xl transition">Lanjutkan Belajar</a>
        <% } %>
      <% } else if (!user) { %>
        <a href="/login?next=<%= encodeURIComponent('/courses/' + course.slug) %>" class="block text-center w-full bg-brand-600 hover:bg-brand-700 text-white font-semibold py-3 rounded-xl transition">Masuk untuk Membeli</a>
        <p class="text-xs text-slate-400 text-center mt-3">Belum punya akun? <a href="/register" class="text-brand-600 font-semibold">Daftar gratis</a></p>
      <% } else { %>
        <a href="/checkout/<%= course.slug %>" class="block text-center w-full bg-accent-500 hover:bg-accent-600 text-white font-semibold py-3 rounded-xl transition"><%= course.price > 0 ? 'Beli Sekarang' : 'Mulai Belajar Gratis' %></a>
      <% } %>

      <ul class="mt-5 space-y-2 text-sm text-slate-500">
        <li class="flex items-center gap-2">✅ Akses selama <%= course.access_duration_days %> hari setelah pembayaran</li>
        <li class="flex items-center gap-2">✅ Video bisa ditonton kapan saja</li>
        <li class="flex items-center gap-2">✅ Beberapa video gratis untuk dicoba dulu</li>
      </ul>
    </div>
  </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
  <h2 class="font-display text-2xl font-bold text-slate-900 mb-3">Deskripsi Course</h2>
  <p class="text-slate-600 leading-relaxed mb-10 whitespace-pre-line"><%= course.description %></p>

  <h2 class="font-display text-2xl font-bold text-slate-900 mb-5">Kurikulum</h2>
  <div class="space-y-4">
    <% sections.forEach(section => { %>
      <div class="bg-white border border-slate-100 rounded-2xl overflow-hidden">
        <div class="bg-slate-50 px-5 py-3 font-semibold text-slate-800 text-sm"><%= section.title %></div>
        <ul class="divide-y divide-slate-100">
          <% section.lessons.forEach(lesson => { %>
            <li class="px-5 py-3.5 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <span class="text-slate-300">
                  <% if (lesson.is_free || hasAccess) { %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  <% } else { %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>
                  <% } %>
                </span>
                <% if (lesson.is_free || hasAccess) { %>
                  <a href="/courses/<%= course.slug %>/watch/<%= lesson.id %>" class="text-sm text-slate-700 hover:text-brand-600 font-medium"><%= lesson.title %></a>
                <% } else { %>
                  <span class="text-sm text-slate-400"><%= lesson.title %></span>
                <% } %>
                <% if (lesson.is_free) { %><span class="text-[10px] font-bold text-mint-600 bg-mint-400/10 px-2 py-0.5 rounded-full">GRATIS</span><% } %>
              </div>
              <span class="text-xs text-slate-400"><%= lesson.duration_minutes %> menit</span>
            </li>
          <% }) %>
        </ul>
      </div>
    <% }) %>
  </div>
</div>

<%- include('partials/footer') %>
