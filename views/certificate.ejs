<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sertifikat - <%= course.title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root { --ink: #172554; --gold: #d97706; --paper: #fffdf7; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; background: #e2e8f0; color: var(--ink); font-family: Poppins, sans-serif; }
    .actions { padding: 24px; text-align: center; }
    .actions a, .actions button { border: 0; background: var(--ink); color: white; padding: 11px 18px; border-radius: 8px; text-decoration: none; font: 600 14px Poppins, sans-serif; cursor: pointer; }
    .certificate { width: min(1120px, calc(100% - 32px)); min-height: 790px; margin: 0 auto 32px; padding: 72px; display: flex; flex-direction: column; justify-content: center; text-align: center; background: var(--paper); border: 14px solid var(--ink); outline: 2px solid var(--gold); outline-offset: -28px; }
    .logo { width: 92px; height: 92px; object-fit: contain; margin: 0 auto 14px; }
    .brand { font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: var(--gold); }
    h1 { margin: 38px 0 12px; font: 700 clamp(34px, 6vw, 68px) 'Playfair Display', serif; }
    .lead { margin: 0; color: #475569; font-size: 18px; }
    .name { margin: 20px 0; font: 700 clamp(28px, 5vw, 52px) 'Playfair Display', serif; border-bottom: 1px solid #cbd5e1; padding-bottom: 12px; }
    .course { font-size: 25px; font-weight: 600; }
    .meta { margin-top: 64px; display: flex; justify-content: space-between; gap: 24px; color: #64748b; font-size: 12px; }
    .signature { margin-top: 42px; margin-left: auto; width: 220px; text-align: center; }
    .signature img { display: block; width: 180px; height: 72px; object-fit: contain; margin: 0 auto -8px; }
    .signature-line { border-top: 1px solid #94a3b8; padding-top: 8px; font-size: 13px; font-weight: 600; }
    @media print { body { background: white; } .actions { display: none; } .certificate { width: 100%; height: 100vh; margin: 0; } @page { size: landscape; margin: 0; } }
    @media (max-width: 640px) { .certificate { min-height: 620px; padding: 44px 24px; border-width: 9px; outline-offset: -20px; } .meta { margin-top: 40px; flex-direction: column; } }
  </style>
</head>
<body>
  <div class="actions"><button type="button" onclick="window.print()">Cetak / Simpan sebagai PDF</button> <a href="/dashboard">Kembali ke dashboard</a></div>
  <main class="certificate">
    <img class="logo" src="/images/logosukacoding2.png" alt="Logo SukaCoding" />
    <div class="brand">SukaCoding</div>
    <h1>Sertifikat Penyelesaian</h1>
    <p class="lead">Dengan bangga diberikan kepada</p>
    <div class="name"><%= user.name %></div>
    <p class="lead">telah menyelesaikan course</p>
    <div class="course"><%= course.title %></div>
    <div class="meta"><span>Nomor: <%= certificateNumber %></span><span>Selesai: <%= new Date(completedAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></span></div>
    <div class="signature">
      <img src="/images/ttdwisnu-removebg-preview.png" alt="Tanda tangan instructor" onerror="this.style.display='none'" />
      <div class="signature-line"><%= instructorName %><br /><span style="font-weight: 400; color: #64748b;">Instructor</span></div>
    </div>
  </main>
</body>
</html>
