<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="min-h-[80vh] flex items-center justify-center px-4 py-16 bg-slate-50">
  <div class="w-full max-w-md text-center">
    <div class="w-20 h-20 mx-auto rounded-full bg-brand-50 flex items-center justify-center mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
      </svg>
    </div>
    <h1 class="font-display text-2xl font-bold text-slate-900 mb-2">Cek Email Anda</h1>
    <p class="text-slate-500 mb-1">Kami sudah mengirim link verifikasi ke:</p>
    <p class="font-semibold text-slate-800 mb-6"><%= email %></p>
    <p class="text-sm text-slate-500 mb-8">Klik link di email tersebut untuk mengaktifkan akun Anda. Jangan lupa cek folder Spam/Promosi kalau belum muncul di inbox.</p>

    <% if (typeof resendMessage !== 'undefined') { %>
      <div class="bg-mint-400/10 text-mint-600 text-sm rounded-lg p-3 mb-6"><%= resendMessage %></div>
    <% } %>

    <form action="/resend-verification" method="POST" class="bg-white border border-slate-100 rounded-2xl p-5">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <p class="text-sm text-slate-500 mb-3">Tidak menerima email?</p>
      <input type="email" name="email" required value="<%= email %>" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm mb-3 focus:ring-2 focus:ring-brand-500 outline-none" />
      <button type="submit" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-semibold py-2.5 rounded-xl transition text-sm">Kirim Ulang Link Verifikasi</button>
    </form>

    <a href="/login" class="inline-block mt-6 text-sm text-brand-600 font-semibold hover:underline">Sudah verifikasi? Masuk di sini</a>
  </div>
</div>

<%- include('partials/footer') %>
